DJANGO_SECRET_KEY=troque-esta-chave-em-cada-ambiente
DEBUG=True
# 10.0.2.2 é o localhost da máquina visto pelo emulador Android
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://postgres:postgres@localhost:5432/imoveis_aqui

# Opcional: pasta dos arquivos privados (documentos de contrato e comprovantes).
# Padrão: Web/arquivos_privados. Precisa ficar fora de media/.
# ARQUIVOS_PRIVADOS_ROOT=

# Limite de taxa das rotas públicas da vitrine (requisições por IP; formato do DRF: número/periodo)
VITRINE_TAXA_ANONIMA=120/min
# Número de proxies confiáveis na frente da API. Em desenvolvimento deixe comentado (padrão 0: usa o IP da
# conexão). EM PRODUÇÃO INFORME SEMPRE: atrás de proxy reverso (nginx, load balancer) use o número de proxies
# (ex.: 1); sem proxy, use 0 de propósito. Sem a variável, todos os visitantes dividem o IP do proxy e o mesmo
# limite de taxa (um cliente abusivo bloqueia todos com 429) — `manage.py check --deploy` avisa (core.W001).
# NUM_PROXIES=1
